#!/sbin/openrc-run

description="GoToSocial Lightweight ActivityPub / Mastodon Server"

command="/usr/bin/gotosocial"
command_args="--config-path ${GTS_CONFIG:-/etc/gotosocial/config.yaml} server start"
command_user="${GTS_USER:-root}"
command_background="yes"
pidfile="/run/gotosocial.pid"
output_log="/var/log/gotosocial.log"
error_log="/var/log/gotosocial.err"

depend() {
    need net
    after p2pt appliance-setup
}

start_pre() {
    mkdir -p /mnt/data/gotosocial/storage
    chmod -R 755 /mnt/data/gotosocial
    mkdir -p /etc/gotosocial

    # Si p2pt-server genera /etc/gotosocial/config.yaml o ya existe en /mnt/data/gotosocial
    if [ ! -f /mnt/data/gotosocial/config.yaml ] && [ -f /etc/gotosocial/config.yaml ]; then
        cp /etc/gotosocial/config.yaml /mnt/data/gotosocial/config.yaml
    fi
    ln -sf /mnt/data/gotosocial/config.yaml /etc/gotosocial/config.yaml 2>/dev/null || true

    # Fix: Ensure protocol is https when behind external TLS proxy
    if [ -f /etc/gotosocial/config.yaml ]; then
        sed -i 's/^protocol: "http"$/protocol: "https"/' /etc/gotosocial/config.yaml
    fi
}
