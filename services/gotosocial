#!/sbin/openrc-run

description="GoToSocial Lightweight ActivityPub / Mastodon Server"

command="/mnt/data/bin/gotosocial"
command_args="server start --config-path ${GTS_CONFIG:-/mnt/data/gotosocial/config.yaml}"
command_user="${GTS_USER:-root}"
command_background="yes"
pidfile="/run/gotosocial.pid"
output_log="/var/log/gotosocial.log"
error_log="/var/log/gotosocial.err"

depend() {
    need net
    after p2pt
}

start_pre() {
    checkpath -d -m 0755 /mnt/data/gotosocial
    checkpath -d -m 0755 /mnt/data/gotosocial/storage
    mkdir -p /etc/gotosocial
    ln -sf /mnt/data/gotosocial/config.yaml /etc/gotosocial/config.yaml 2>/dev/null || true
    ln -sf /mnt/data/bin/gotosocial /usr/bin/gotosocial 2>/dev/null || true
}
